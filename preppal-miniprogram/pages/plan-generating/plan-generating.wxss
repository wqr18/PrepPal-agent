.gen-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 90rpx 8rpx 0;
}

/* 圆形 AI 动效 */
.orb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 34% 30%, #6e8bf5, #2b4acb 62%, #1b2f87);
  box-shadow: 0 22rpx 44rpx -18rpx rgba(43, 74, 203, 0.75);
  color: #ffffff;
  font-weight: 700;
  font-size: 40rpx;
  letter-spacing: 0.5rpx;
}

.orb::before {
  content: '';
  position: absolute;
  top: -28rpx;
  right: -28rpx;
  bottom: -28rpx;
  left: -28rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(43, 74, 203, 0.24);
  border-top-color: var(--pp-brand);
  animation: orb-spin 1.5s linear infinite;
}

.orb::after {
  content: '';
  position: absolute;
  top: -56rpx;
  right: -56rpx;
  bottom: -56rpx;
  left: -56rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(43, 74, 203, 0.18);
  animation: orb-spin 8s linear infinite reverse;
}

.orb--fail {
  background: radial-gradient(circle at 34% 30%, #f09a9d, #e5484d 62%, #a3262b);
  box-shadow: 0 22rpx 44rpx -18rpx rgba(229, 72, 77, 0.7);
}

.orb--fail::before {
  border-color: rgba(229, 72, 77, 0.24);
  border-top-color: var(--pp-danger);
}

@keyframes orb-spin {
  to {
    transform: rotate(360deg);
  }
}

.gen-wrap__title {
  font-size: 34rpx;
  font-weight: 650;
  margin-top: 60rpx;
  letter-spacing: -0.3rpx;
}

.gen-wrap__sub {
  font-size: 24rpx;
  color: var(--pp-ink-3);
  margin-top: 18rpx;
  line-height: 1.7;
}

.gen-wrap__progress {
  width: 100%;
  margin-top: 44rpx;
}

.gen-steps {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 40rpx;
}

.gen-step {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 24rpx;
  color: var(--pp-ink-3);
  background: #ffffff;
  border: 1rpx solid var(--pp-line);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  text-align: left;
}

.gen-step__dot {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  border-radius: 50%;
  border: 3rpx solid #d7deea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-step--doing {
  color: var(--pp-brand);
  border-color: var(--pp-brand-100);
  background: var(--pp-brand-50);
}

.gen-step--doing .gen-step__dot {
  border-color: var(--pp-brand);
  border-top-color: transparent;
  animation: orb-spin 0.8s linear infinite;
}

.gen-step--done {
  color: var(--pp-ink-2);
}

.gen-step--done .gen-step__dot {
  background: var(--pp-ok);
  border-color: var(--pp-ok);
}

.gen-refs {
  width: 100%;
  margin-top: 36rpx;
  font-size: 22rpx;
  color: var(--pp-ink-3);
  background: #ffffff;
  border: 1rpx dashed var(--pp-line);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  line-height: 1.7;
  text-align: left;
}

.gen-fail__actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 44rpx;
}
