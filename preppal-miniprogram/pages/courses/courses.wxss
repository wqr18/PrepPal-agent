.courses__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 20rpx 4rpx 24rpx;
}

.course {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform 0.14s;
}

.course:active {
  transform: scale(0.99);
}

.course__name {
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: -0.2rpx;
}

.course__desc {
  font-size: 23rpx;
  color: var(--pp-ink-3);
  line-height: 1.6;
  margin-top: 10rpx;
}
