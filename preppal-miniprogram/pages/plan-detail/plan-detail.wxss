.plan__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 4rpx 0;
}

.plan__head-text {
  flex: 1;
  min-width: 0;
}

.plan__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 1.35;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.plan__meta {
  font-size: 22rpx;
  color: var(--pp-ink-3);
  line-height: 1.6;
  margin-top: 14rpx;
}

.plan__cancel {
  color: var(--pp-brand);
  margin-left: auto;
  flex-shrink: 0;
}

.plan__notice {
  margin-top: 22rpx;
}

.plan__section {
  margin-top: 22rpx;
}

.plan__ph {
  color: #a9b2c0;
}

/* 三维教学目标 */
.plan__goal-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
}

.plan__goal-row + .plan__goal-row {
  border-top: 1rpx dashed var(--pp-line);
}

.plan__goal-key {
  flex: 0 0 92rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--pp-brand);
  background: var(--pp-brand-50);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.plan__goal-key--k2 {
  color: #0f8a4a;
  background: #eef7f1;
}

.plan__goal-key--k3 {
  color: var(--pp-warn);
  background: #fff6e6;
}

.plan__goal-input {
  flex: 1;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
}

.plan__text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--pp-ink-2);
}

/* 教学过程编辑态 */
.plan__tl-stage {
  width: 160rpx;
  flex: 0 0 160rpx;
}

.plan__tl-min {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan__tl-min-input {
  width: 110rpx;
  text-align: center;
}

.plan__tl-min-unit {
  font-size: 22rpx;
  color: var(--pp-ink-3);
}

.plan__tl-textarea {
  min-height: 140rpx;
}

/* 参考资料 */
.plan__refs {
  padding: 26rpx 28rpx 28rpx;
}

.plan__refs-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan__ref-item {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 0;
}

.plan__ref-item + .plan__ref-item {
  border-top: 1rpx solid var(--pp-line-2);
}

.plan__ref-ic {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 18rpx;
  background: var(--pp-brand-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan__ref-name {
  font-size: 27rpx;
  font-weight: 600;
  word-break: break-all;
}

.plan__ref-sec {
  font-size: 22rpx;
  color: var(--pp-brand);
  margin-top: 8rpx;
}

.plan__ref-foot {
  font-size: 22rpx;
  color: var(--pp-ink-3);
  line-height: 1.7;
  margin-top: 18rpx;
}

.plan__ref-action {
  margin-top: 20rpx;
}

/* 引用原文弹层 */
.ref-pop__title {
  font-size: 30rpx;
  font-weight: 650;
  word-break: break-all;
}

.ref-pop__sec {
  font-size: 23rpx;
  color: var(--pp-brand);
  margin-top: 12rpx;
}

.ref-pop__body {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--pp-ink-2);
  background: #f7f9ff;
  border: 1rpx solid var(--pp-brand-100);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 22rpx;
}

.ref-pop__btn {
  margin-top: 32rpx;
}
