.materials__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin: 16rpx 4rpx 24rpx;
}

.materials__hint {
  margin-bottom: 24rpx;
}

.materials__status {
  margin-top: 16rpx;
}

.materials__ops {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.materials__pending {
  font-size: 22rpx;
  color: var(--pp-ink-3);
  margin-top: 14rpx;
  line-height: 1.5;
}
